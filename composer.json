{
  "name": "sol-parts/payum-liqpay",
  "type": "library",
  "description": "Payum gateway for LiqPay: hosted checkout redirect and embedded widget",
  "keywords": ["payum", "payment", "liqpay", "privatbank", "widget", "ukraine"],
  "homepage": "https://sol.parts",
  "license": "MIT",
  "authors": [
    {
      "name": "Andrii Didenko",
      "email": "andrii@didenko.dev"
    },
    {
      "name": "Oleksandr Nechyporuk",
      "email": "oleksandr@nechyporuk.name"
    }
  ],
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "payum/core": "^1.7",
    "php-http/discovery": "^1.14",
    "psr/http-factory": "^1.0",
    "psr/http-message": "^1.1|^2.0"
  },
  "require-dev": {
    "nyholm/psr7": "^1.8",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "sol-parts/payum-contracts": "Dispatch the shared DoCapture request to settle (hold_completion) held payments"
  },
  "autoload": {
    "psr-4": {
      "SolParts\\PayumLiqPay\\": ""
    },
    "exclude-from-classmap": [
      "/Tests/"
    ]
  }
}
